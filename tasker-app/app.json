{
  "expo": {
    "name": "Tasker",
    "slug": "tasker-tcc",
    "version": "3.0.0",
    "orientation": "portrait",
    "scheme": "tasker",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.sirius.tasker",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#100A14"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true

    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cbbe497e-b2aa-4dc4-9225-3ceac7876e2c"
      }

    }
  }
}
