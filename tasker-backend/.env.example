# Exemplo local: copie para .env; NÃO envie .env para o GitHub.
DEBUG=true
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
ALLOWED_HOSTS=localhost,127.0.0.1
# Em produção, use URL interna do Render Key Value, mesma região do backend.
REDIS_URL=redis://localhost:6379/0
# Para worker separado, é possível usar outra instância de Redis.
# CELERY_BROKER_URL=redis://localhost:6379/1
# Bucket Firebase Storage (nome exato do console, sem gs://)
FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
# Desenvolvimento: caminho ABSOLUTO da chave baixada do Firebase (somente backend)
FIREBASE_CREDENTIALS=/caminho/fora/do/repositorio/service-account.json
# Produção no Render: forneça JSON INTEIRO em uma env var, não commite o arquivo.
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
